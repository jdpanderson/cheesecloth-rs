[Unit]
Description=cheesecloth peer-to-peer WireGuard mesh
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=-/etc/default/cheesecloth
ExecStart=/usr/bin/cheesecloth daemon $CHEESECLOTH_OPTS
Restart=on-failure
RestartSec=5
StateDirectory=cheesecloth
StateDirectoryMode=0700
# Written to despite ProtectSystem=strict: userspace WireGuard's control
# sockets, and resolvconf's state (used when removing the interface). Shared
# with other software, so kept when the service stops.
RuntimeDirectory=wireguard resolvconf
RuntimeDirectoryPreserve=yes

# Runs as root, but with only the rights it needs: network administration, and
# /dev/net/tun for userspace WireGuard.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
