# Maintainer: Jonathan Anderson <janderson@janderson.ca>
# Builds the commit checked out in this repository:
#   cd packaging/arch && makepkg -si
pkgname=cheesecloth
pkgver=0.0.0
pkgrel=1
pkgdesc='A lightweight, loose mesh: a peer-to-peer WireGuard cluster'
arch=('x86_64' 'aarch64')
# Cheesecloth is MIT; the others are the bundled crates' (THIRD-PARTY-NOTICES.md).
license=('MIT' 'Apache-2.0' 'BSD-2-Clause' 'BSD-3-Clause' 'ISC' 'MPL-2.0' 'Unicode-3.0')
depends=('gcc-libs' 'glibc' 'resolvconf')
makedepends=('cargo' 'git')
optdepends=('wireguard-tools: inspect the interface with wg')
backup=('etc/default/cheesecloth')
options=('!lto')
source=("$pkgname::git+file://$(realpath "$startdir/../..")#commit=$(git -C "$startdir/../.." rev-parse HEAD)")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local version
  version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n1)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p cheesecloth
}

check() {
  cd "$pkgname"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release --workspace
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/cheesecloth -t "$pkgdir/usr/bin"
  install -Dm644 packaging/cheesecloth.service -t "$pkgdir/usr/lib/systemd/system"
  install -Dm644 packaging/cheesecloth.default "$pkgdir/etc/default/cheesecloth"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/$pkgname/docs"
  install -Dm644 LICENSE THIRD-PARTY-NOTICES.md -t "$pkgdir/usr/share/licenses/$pkgname"
}
